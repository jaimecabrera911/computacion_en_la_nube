# ---------------------------------------------------------------------------
# Configuración del proyecto ACA N° 1 — Computación en la Nube
# Copie este archivo como `.env` y complete los valores:
#     cp .env.example .env
# El archivo `.env` está en `.gitignore`: nunca se versiona.
# ---------------------------------------------------------------------------

# --- Base de datos vectorial cloud (Qdrant Cloud) -------------------------
# Obtenga su URL y su API Key en https://cloud.qdrant.io
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Si se dejan vacíos, el pipeline ejecuta en modo cliente local/in-memory,
# útil para reproducir la demo sin conexión:
# QDRANT_URL=
# QDRANT_API_KEY=

# --- Nombre de la colección vectorial --------------------------------------
QDRANT_COLLECTION_NAME=clinical_heart_disease_rag

# --- Modelo de embeddings multilingüe (optimizado para español) -----------
# Sentence Transformers · 384 dimensiones · corre en CPU · sin costo de API
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
